# ==============================================================================
# MinePerform — Environment Variables Template
# Copy this file to `.env` (gitignored) and populate with your credentials.
# NEVER commit real tokens, Firebase service account keys, or OAuth secrets.
# ==============================================================================

# --- Free Figma / Penpot Design MCP (0 Rupiah) ---
FIGMA_API_KEY=figd_your_figma_personal_access_token_here
PENPOT_API_URL=https://design.penpot.app
PENPOT_ACCESS_TOKEN=your_penpot_access_token_here

# --- GitHub MCP ---
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# --- Firebase Spark Free Tier (Immortal Cloud Sync) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# --- Google OAuth 2.0 (PC Desktop PKCE & Android Credential Manager) ---
GOOGLE_OAUTH_DESKTOP_CLIENT_ID=your_desktop_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# --- Local Paths & External Connectors ---
MINEPERFORM_SQLITE_PATH=./data/mineperform.sqlite
MINEPERFORM_ONEDRIVE_ROOT=C:\Users\YourName\OneDrive\Data_Periksa_2026
SIAP_NEO_IPC_ENDPOINT=\\.\pipe\siap-neo-bridge
BOT_MONITOR_DOWNLOAD_DIR=C:\Users\YourName\Downloads\BotMonitorPeriksa
