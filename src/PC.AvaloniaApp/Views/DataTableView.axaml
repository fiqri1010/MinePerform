<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinePerform.PC.ViewModels"
             xmlns:schema="using:MinePerform.Core.SchemaStudio"
             x:Class="MinePerform.PC.Views.DataTableView"
             x:DataType="vm:DataTablePageViewModel">

  <DockPanel Margin="24,16" LastChildFill="True">

    <!-- 1. Table Tabs & Action Toolbar -->
    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
      <!-- Dynamic Tables Switcher (1-5+ tables per year) -->
      <WrapPanel Orientation="Horizontal">
        <ItemsControl ItemsSource="{Binding Tables}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="schema:TableDefinition">
              <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,4">
                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>

      <!-- Action Buttons + Column-Group Quick-Jump Pills (Zero-Collision WrapPanel) -->
      <WrapPanel Orientation="Horizontal">
        <Button Content="+ Baris" Command="{Binding AddQuickSampleRowCommand}" Padding="12,6" CornerRadius="6" Margin="0,0,8,8" />
        <Button Content="📄 Unggah DATA_INPUT.xlsx" Click="OnImportExcelClicked" Padding="12,6" CornerRadius="6" Margin="0,0,8,8" />

        <Border Width="1" Background="#334155" Margin="4,0,12,8" />

        <!-- 4 Semantic Super-Header Banding Pills -->
        <Button Classes="GroupPill" Content="Semua" Command="{Binding ToggleGroupCommand}" CommandParameter="ALL" Background="#334155" Margin="0,0,6,8" />
        <Button Classes="GroupPill" Content="🔵 Info Dasar (30)" Command="{Binding ToggleGroupCommand}" CommandParameter="INFO DASAR" Background="#1E3A8A40" BorderBrush="#3B82F6" Margin="0,0,6,8" />
        <Button Classes="GroupPill" Content="🟠 Pemeriksaan (14)" Command="{Binding ToggleGroupCommand}" CommandParameter="DATA PEMERIKSAAN" Background="#78350F40" BorderBrush="#F59E0B" Margin="0,0,6,8" />
        <Button Classes="GroupPill" Content="🟣 Putusan PFPD (11)" Command="{Binding ToggleGroupCommand}" CommandParameter="PUTUSAN PFPD" Background="#4C1D9540" BorderBrush="#8B5CF6" Margin="0,0,6,8" />
        <Button Classes="GroupPill" Content="🟢 OneDrive (1)" Command="{Binding ToggleGroupCommand}" CommandParameter="LINK DATA" Background="#064E3B40" BorderBrush="#10B981" Margin="0,0,6,8" />
      </WrapPanel>

      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8" />
    </StackPanel>

    <!-- 2. Master-Detail Row Drawer (Bottom Panel for PIB Lembar Lanjutan, Containers & OneDrive) -->
    <Border DockPanel.Dock="Bottom"
            Classes="BentoCard"
            Margin="0,12,0,0"
            Padding="12"
            MaxHeight="160">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="📂 LACI RINCIAN MASTER-DETAIL (Lembar Lanjutan PIB, Kontainer, Dokumen &amp; Folder OneDrive)"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#38BDF8"
                   Margin="0,0,0,8" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding SelectedRowDetails}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RowDetailDisplayItem">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                  <Border Background="#064E3B40" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#10B981" />
                  </Border>
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 3. Virtualized DataGrid with 3 FROZEN COLUMNS & 4 Super-Header Bands -->
    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
      <DataGrid ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                FrozenColumnCount="3"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="All"
                RowHeight="36">
        <DataGrid.Columns>
          <!-- FROZEN (3 Identity Columns) -->
          <DataGridTextColumn Header="No." Binding="{Binding No}" Width="64" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="84" />
          <DataGridTextColumn Header="No. IP" Binding="{Binding NoIp}" Width="120" />

          <!-- 🔵 INFO DASAR -->
          <DataGridTextColumn Header="🔵 Tanggal IP" Binding="{Binding TanggalIp}" Width="108" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />
          <DataGridTextColumn Header="🔵 TPS" Binding="{Binding Tps}" Width="80" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />
          <DataGridTextColumn Header="🔵 Importir" Binding="{Binding Importir}" Width="200" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />
          <DataGridTextColumn Header="🔵 FCL/LCL" Binding="{Binding FclLcl}" Width="80" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />
          <DataGridTextColumn Header="🔵 Jns" Binding="{Binding JumlahJenis}" Width="64" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />
          <DataGridTextColumn Header="🔵 JENIS BARANG" Binding="{Binding JenisBarang}" Width="220" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />
          <DataGridTextColumn Header="🔵 TOTAL PDRI" Binding="{Binding TotalPdri}" Width="140" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowInfoDasar}" />

          <!-- 🟠 DATA PEMERIKSAAN -->
          <DataGridTextColumn Header="🟠 TK" Binding="{Binding TkPeriksa}" Width="84" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowDataPemeriksaan}" />
          <DataGridTextColumn Header="🟠 Waktu PKB" Binding="{Binding WaktuPkb}" Width="144" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowDataPemeriksaan}" />
          <DataGridTextColumn Header="🟠 Mulai Periksa" Binding="{Binding WaktuMulai}" Width="144" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowDataPemeriksaan}" />
          <DataGridTextColumn Header="🟠 Selesai LHP" Binding="{Binding SelesaiLhp}" Width="144" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowDataPemeriksaan}" />
          <DataGridTextColumn Header="🟠 TEMUAN?" Binding="{Binding Temuan}" Width="88" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowDataPemeriksaan}" />

          <!-- 🟣 PUTUSAN PFPD -->
          <DataGridTextColumn Header="🟣 NOTUL?" Binding="{Binding Notul}" Width="88" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowPutusanPfpd}" />
          <DataGridTextColumn Header="🟣 Total Kurang Bayar" Binding="{Binding TotalKurangBayar}" Width="152" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowPutusanPfpd}" />

          <!-- 🟢 LINK DATA -->
          <DataGridTextColumn Header="🟢 Nama Folder Onedrive" Binding="{Binding NamaFolderOnedrive}" Width="280" IsVisible="{Binding $parent[UserControl].((vm:DataTablePageViewModel)DataContext).ShowLinkData}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </DockPanel>
</UserControl>
