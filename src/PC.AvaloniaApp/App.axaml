<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="MinePerform.PC.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- Crisp Vector Stream Geometries (Zero-Emoji Polish) -->
    <StreamGeometry x:Key="IconDashboard">M3 3h7v9H3V3zm11 0h7v5h-7V3zm0 9h7v9h-7v-9zM3 16h7v5H3v-5z</StreamGeometry>
    <StreamGeometry x:Key="IconTable">M3 3h18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 6h18M9 9v12</StreamGeometry>
    <StreamGeometry x:Key="IconFormula">M14 4a2 2 0 0 1 2-2 2 2 0 0 1 2 2v1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-1a2 2 0 0 0-2 2v1a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2h-1a2 2 0 0 1-2-2 2 2 0 0 1 2-2h1a2 2 0 0 0 2-2V4z</StreamGeometry>
    <StreamGeometry x:Key="IconConnectors">M12 2a2 2 0 0 1 2 2v2h4a2 2 0 0 1 2 2v4h2a2 2 0 0 1 0 4h-2v4a2 2 0 0 1-2 2h-4v2a2 2 0 0 1-4 0v-2H6a2 2 0 0 1-2-2v-4H2a2 2 0 0 1 0-4h2V8a2 2 0 0 1 2-2h4V4a2 2 0 0 1 2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm10 2-4.35-4.35</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconUpload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12</StreamGeometry>
    <StreamGeometry x:Key="IconMenu">M4 6h16M4 12h16M4 18h16</StreamGeometry>
    <StreamGeometry x:Key="IconCopy">M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M2 6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6z</StreamGeometry>
    <StreamGeometry x:Key="IconSparkles">M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z</StreamGeometry>
    <StreamGeometry x:Key="IconCheckCircle">M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <semi:SemiTheme Locale="en-US" />
    <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />

    <!-- Fluent 2 Elevated Bento Card -->
    <Style Selector="Border.BentoCard">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#1E293B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.SubtleCard">
      <Setter Property="Background" Value="#0D1424" />
      <Setter Property="BorderBrush" Value="#1E293B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Navigation Rail Buttons -->
    <Style Selector="Button.NavRailBtn">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.NavRailBtn:pointerover">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <!-- Modern Action Buttons -->
    <Style Selector="Button.PrimaryAction">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>
    <Style Selector="Button.PrimaryAction:pointerover">
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
    </Style>

    <Style Selector="Button.SecondaryAction">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#F1F5F9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#334155" />
    </Style>
    <Style Selector="Button.SecondaryAction:pointerover">
      <Setter Property="Background" Value="#273549" />
      <Setter Property="BorderBrush" Value="#475569" />
    </Style>

    <Style Selector="Button.GroupPill">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.TokenChip">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- DataGrid Polish -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="#0B101B" />
      <Setter Property="RowBackground" Value="#0E1422" />
      <Setter Property="BorderBrush" Value="#1E293B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="MaxHeight" Value="38" />
    </Style>

    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#162032" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="#1E293B" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
  </Application.Styles>
</Application>
