<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="MinePerform.PC.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <semi:SemiTheme Locale="en-US" />
    <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />

    <!-- Global 8pt Spatial Grid & Zero-Collision Typography Overrides -->
    <Style Selector="Border.BentoCard">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.IkuCard">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Button.NavRailBtn">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CBD5E1" />
    </Style>

    <Style Selector="Button.NavRailBtn:pointerover">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <Style Selector="Button.TokenChip">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.GroupPill">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MaxHeight" Value="36" />
    </Style>
  </Application.Styles>
</Application>
